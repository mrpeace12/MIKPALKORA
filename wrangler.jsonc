{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mikpal",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-26",
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "9fa1f043338442e08b8efcd59495d47f"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mikpal-db",
      "database_id": "YOUR_DATABASE_ID_FROM_STEP_1"
    }
  ]
}
