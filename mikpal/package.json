{
  "name": "mikpal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create mikpal-db",
    "db:migrate": "wrangler d1 execute mikpal-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute mikpal-db --local --file=./schema.sql"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.47.0",
    "@cloudflare/workers-types": "^4.20250726.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wrangler": "^4.114.0"
  }
}
